# ── Provider ─────────────────────────────────────────────────────────────────
# "google"  → official google-genai SDK (requires GEMINI_API_KEY)
# "nvidia"  → OpenAI-compatible chat-completions endpoint (requires NVIDIA_API_KEY)
# Leave unset to auto-select: google when GEMINI_API_KEY exists, else nvidia.
GEMMA_PROVIDER=

# ── Google Gemini API ────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── OpenAI-compatible endpoint (alternative provider) ────────────────────────
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Model & reasoning ────────────────────────────────────────────────────────
GEMMA_MODEL=gemma-4-31b-it
GEMMA_THINKING_LEVEL=high

# ── CORS ─────────────────────────────────────────────────────────────────────
# Any localhost port is allowed by default (allow_origin_regex). Add
# non-local origins here if you deploy the frontend separately.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001
